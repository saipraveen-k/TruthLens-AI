# Application Settings
APP_NAME="TruthLens AI"
VERSION="1.0.0"
DEBUG=True
SECRET_KEY="your-secret-key-here-change-in-production"

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=truthlens_db
DB_USER=postgres
DB_PASSWORD=postgres

# API Keys (Get from respective services)
NEWS_API_KEY=your-news-api-key-here
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Model Paths
BERT_MODEL_PATH="./models_training/saved_models/bert_fake_news.pt"
LSTM_MODEL_PATH="./models_training/saved_models/lstm_fake_news.h5"
BASELINE_MODEL_PATH="./models_training/saved_models/baseline_model.pkl"

# Processing Settings
MAX_TEXT_LENGTH=10000
DEFAULT_LANGUAGE="en"
SUPPORTED_LANGUAGES=["en", "hi", "es", "fr", "de"]

# Cache Settings
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR="./uploads"

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Logging
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
ENABLE_MULTILINGUAL=True
ENABLE_BROWSER_EXTENSION=True
ENABLE_REAL_TIME_ANALYSIS=False
